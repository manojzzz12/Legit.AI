# Legit.ai / TrustLens AI - Environment Configuration Example
# Copy this file to .env or set these in Vercel Project Settings > Environment Variables
# NEVER commit .env with real secret keys.

# 1. Gemini API (Free tier from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash

# 2. Tavily Search API (Free tier from Tavily: https://app.tavily.com)
TAVILY_API_KEY=
MAX_SEARCHES_PER_CASE=6

# 3. Optional Settings & History/Cache
FRONTEND_ORIGIN=http://localhost:5173
FALLBACK_SEARCH=wikipedia
WIKI_LANG=en
LOCAL_STT=off
ANALYSIS_CACHE_TTL_HOURS=24
