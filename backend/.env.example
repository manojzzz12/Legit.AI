# Copy this file to ".env" and fill in the values. NEVER commit ".env".
# Demo mode works with every value empty.

# Gemini API free tier -> https://aistudio.google.com/app/apikey  (no credit card)
GEMINI_API_KEY=
# Model names change. Tried in order; if one is retired/rate-limited the next is used.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash

# Tavily free tier -> https://app.tavily.com  (no credit card)
TAVILY_API_KEY=
# Safety cap on web searches per analysis (1 credit each). Up to 6 factual claims are
# extracted per case, so 6 searches every one of them. Lower it to save free-tier credits.
MAX_SEARCHES_PER_CASE=6

# Frontend origin allowed by CORS (Vite dev server default)
FRONTEND_ORIGIN=http://localhost:5173

# Backup web search used automatically when Tavily is missing, out of credits or down.
# "wikipedia" = free MediaWiki API (no key). Set to "off" to disable.
FALLBACK_SEARCH=wikipedia
WIKI_LANG=en

# OPTIONAL offline speech-to-text backup (free). Install with: pip install faster-whisper
# Used only if Gemini transcription fails. Downloads a ~75 MB model on first use.
LOCAL_STT=on
WHISPER_MODEL=tiny

# Analysis cache TTL in hours (default: 24)
ANALYSIS_CACHE_TTL_HOURS=24
